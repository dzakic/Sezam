@page "/Conference/{ConfName}/{TopicName?}"
@model Sezam.Web.Pages.Conference.ConfModel

@{
    var title = Model.Topic != null ? Model.ConfName + " : " + Model.Topic?.Name : Model.ConfName;
    if (Model.PageNumber > 1) title += $" - Page {Model.PageNumber}";
    ViewData["Title"] = title;
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

@section Meta {
    @if (Model.PageNumber > 1)
    {
        <link rel="prev" href="@Url.Page("./Conf", new { ConfName = Model.ConfName, TopicName = Model.TopicName, p = Model.PageNumber - 1 })" />
    }
    @if (Model.PageNumber < Model.TotalPages)
    {
        <link rel="next" href="@Url.Page("./Conf", new { ConfName = Model.ConfName, TopicName = Model.TopicName, p = Model.PageNumber + 1 })" />
    }
    <link rel="canonical" href="@Url.Page("./Conf", new { ConfName = Model.ConfName, TopicName = Model.TopicName, p = Model.PageNumber > 1 ? (int?)Model.PageNumber : null })" />
}

<h1>@Model.ConfName</h1>

<p>@string.Format("{0:dd MMM yyyy} - {1:dd MMM yyyy}", Model.Conference.FromDate, Model.Conference.ToDate)</p>

<div id="Topics">
    <h2>Topics</h2>
    <ol>
        @foreach (var topic in Model.ConfTopics)
        {
            <li value="@topic.TopicNo" class="@(Model.Topic != null && topic.Id == Model.Topic.Id ? "active" : "")">
                <a asp-page="./Conf" asp-route-ConfName="@Model.Conference.VolumeName" asp-route-TopicName="@topic.Name">@topic.Name <span class="topic-sequence">(@topic.NextSequence)</span></a>
            </li>
        }
    </ol>
</div>

<div id="Messages">
    <div class="messages-header d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Messages - @Model.Topic?.Name</h2>
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Page navigation top" class="messages-pagination">
                <span class="page-info mr-2">Page @Model.PageNumber of @Model.TotalPages</span>
                <ul class="pagination pagination-sm d-inline-flex my-0">
                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                        <a class="page-link prev-page-link" asp-route-ConfName="@Model.ConfName" asp-route-TopicName="@Model.TopicName" asp-route-p="@(Model.PageNumber - 1)">&lsaquo; Previous</a>
                    </li>
                    <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link next-page-link" asp-route-ConfName="@Model.ConfName" asp-route-TopicName="@Model.TopicName" asp-route-p="@(Model.PageNumber + 1)">Next &rsaquo;</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
    @if (Model.Messages != null)
    {
        @foreach (var msg in Model.Messages)
        {
            <message>
                <header>
                    <msgid>@msg.MsgId</msgid>
                    <author>@msg.AuthorUsername</author>,
                    <time title="@string.Format("{0:dd/MM/yyyy HH:mm}", msg.Time)">@string.Format("{0:dd MMM yy}", msg.Time)</time>
                    @if (msg.ParentMsgNo is not null)
                    {
                        <reply>-> #@msg.ParentMsgNo, @msg.ParentAuthorUsername</reply>
                    }
                </header>
                <content>@msg.Text</content>
                @if(msg.Filename.Length > 0)
                {
                    <file>@msg.Filename</file>
                }
            </message>
        }
    }
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Page navigation bottom" class="messages-pagination mt-4 d-flex justify-content-end align-items-center">
            <span class="page-info mr-2">Page @Model.PageNumber of @Model.TotalPages</span>
            <ul class="pagination pagination-sm d-inline-flex my-0">
                <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link prev-page-link" asp-route-ConfName="@Model.ConfName" asp-route-TopicName="@Model.TopicName" asp-route-p="@(Model.PageNumber - 1)">&lsaquo; Previous</a>
                </li>
                <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link next-page-link" asp-route-ConfName="@Model.ConfName" asp-route-TopicName="@Model.TopicName" asp-route-p="@(Model.PageNumber + 1)">Next &rsaquo;</a>
                </li>
            </ul>
        </nav>
    }
</div>

